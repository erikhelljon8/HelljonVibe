{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=HelljonVibe.Identity;Trusted_Connection=True;MultipleActiveResultSets=true",
    "SqliteConnection": "Data Source=HelljonVibe.Identity.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AppSettings": {
    "BaseUrl": "https://localhost:5001",
    "FrontendUrl": "https://localhost:3000",
    "Environment": "Development",
    "IsDevelopment": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutDurationInMinutes": 15,
    "PasswordMinLength": 8,
    "PasswordMaxLength": 128,
    "RequireClientSideEncryption": false
  },
  "JwtSettings": {
    "Secret": "your-dev-256-bit-secret-key-here-change-in-production-to-at-least-32-characters",
    "Issuer": "HelljonVibe.Identity",
    "Audience": "HelljonVibe.Client",
    "ExpiryInMinutes": 60,
    "RefreshExpiryInDays": 30
  },
  "EncryptionSettings": {
    "MasterKey": "your-dev-32-byte-encryption-key-here",
    "Algorithm": "AES-256-CBC",
    "IterationCount": 1000,
    "SaltSize": 16,
    "IvSize": 16
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@localhost",
    "FromName": "HelljonVibe Identity (Dev)",
    "UseSsl": false,
    "TemplateDirectory": "EmailTemplates",
    "BaseUrl": "http://localhost:3000"
  }
}
